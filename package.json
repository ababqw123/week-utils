{
  "name": "@jaeyeong/week-utils",
  "version": "0.2.0",
  "description": "Month and ISO week utilities with UTC, KST, and local time zone support",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:types": "tsc --project test/types/tsconfig.json",
    "check": "npm run typecheck && npm test && npm run test:types",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ababqw123/week-utils.git"
  },
  "homepage": "https://github.com/ababqw123/week-utils#readme",
  "bugs": {
    "url": "https://github.com/ababqw123/week-utils/issues"
  },
  "keywords": ["week", "iso-week", "iso8601", "calendar", "date", "typescript", "utc", "kst"],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
